# Copy this file to ".env" and adjust the values you need.
# Every value is optional: without a .env file the defaults below are used.
# Real environment variables always take precedence over the ones set here.

# Port the chat server listens on (3001 is the one freeCodeCamp expects).
PORT=3001

# Largest WebSocket frame accepted, in bytes (16 KB).
MAX_PAYLOAD_BYTES=16384

# How often, in milliseconds, the server pings the clients to find dead ones.
HEARTBEAT_INTERVAL_MS=30000

# Longest chat message accepted, in characters.
MAX_MESSAGE_LENGTH=1000

# Who is the author of a message:
#   true  -> the user of the handshake (?username=...), so nobody can post
#            as somebody else.
#   false -> the username sent inside every message payload.
USE_CONNECTION_IDENTITY=true
